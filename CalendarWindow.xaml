<Window x:Class="Date.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Date 日历"
        Width="388"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        Opacity="0.0"
        SnapsToDevicePixels="True">

    <!-- macOS 26 双环液态玻璃日历弹出卡片（圆角=22，对称留白保证阴影柔和无裁切） -->
    <Border x:Name="CardContainer"
            CornerRadius="22"
            Margin="14"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Resources>
            <!-- 动态主题笔刷（默认深色，由 ApplyTheme 冻结并实时同步） -->
            <SolidColorBrush x:Key="CalFgBrush" Color="#FFF5F5F7"/>
            <SolidColorBrush x:Key="CalSecondaryFgBrush" Color="#CCEBEBF5"/>
            <SolidColorBrush x:Key="CalMutedFgBrush" Color="#AEEBEBF5"/>
            <SolidColorBrush x:Key="CalWeekendFgBrush" Color="#C8FF9B94"/>
            <SolidColorBrush x:Key="CalAccentBrush" Color="#FF0A84FF"/>
            <SolidColorBrush x:Key="CalHoverBrush" Color="#1CFFFFFF"/>
            <SolidColorBrush x:Key="CalPressedBrush" Color="#2CFFFFFF"/>
            <SolidColorBrush x:Key="CalSeparatorBrush" Color="#1CFFFFFF"/>
            <SolidColorBrush x:Key="CalTodayPillBgBrush" Color="#260A84FF"/>
            <SolidColorBrush x:Key="CalTodayPillHoverBrush" Color="#3B0A84FF"/>
            <SolidColorBrush x:Key="CalFooterBgBrush" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="CalFooterBorderBrush" Color="#1EFFFFFF"/>
            <SolidColorBrush x:Key="CalBadgeBgBrush" Color="#22FFFFFF"/>

            <!-- 顶栏圆角导航微按钮样式 (< / >) -->
            <Style x:Key="MacNavButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="28"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource CalFgBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    CornerRadius="8"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CalHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CalPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- “今天”微胶囊按钮样式 -->
            <Style x:Key="MacTodayButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="26"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, -apple-system, PingFang SC, Microsoft YaHei UI"/>
                <Setter Property="Foreground" Value="{DynamicResource CalAccentBrush}"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    CornerRadius="9"
                                    Background="{DynamicResource CalTodayPillBgBrush}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CalTodayPillHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Resources>

        <Border.RenderTransform>
            <TranslateTransform x:Name="CardTranslate" Y="10"/>
        </Border.RenderTransform>

        <Border.Effect>
            <DropShadowEffect x:Name="CardShadow"
                              BlurRadius="26"
                              Direction="270"
                              ShadowDepth="6"
                              Opacity="0.44"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <!-- 内部 1px 液态晶体高光环 -->
            <Border x:Name="CardInnerRim"
                    CornerRadius="21"
                    BorderThickness="1"
                    IsHitTestVisible="False"/>

            <!-- 顶部柔光微折射层 -->
            <Border x:Name="CardSheen"
                    CornerRadius="20.5,20.5,12,12"
                    VerticalAlignment="Top"
                    Height="46"
                    Margin="1,1,1,0"
                    IsHitTestVisible="False"/>

            <StackPanel Margin="18,16,18,15">
                <!-- 1. 顶栏：年月主标题 + 干支生肖副标题 + 导航微胶囊组 -->
                <Grid Margin="2,0,2,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtMonthTitle"
                                   Text="2026年 11月"
                                   FontFamily="Segoe UI Variable Display, -apple-system, BlinkMacSystemFont, PingFang SC, Microsoft YaHei UI"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{DynamicResource CalFgBrush}"/>
                        <TextBlock x:Name="TxtMonthSubtitle"
                                   Text="丙午马年 · 十月"
                                   FontFamily="Segoe UI Variable Text, -apple-system, PingFang SC, Microsoft YaHei UI"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource CalSecondaryFgBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnToday"
                                Content="今天"
                                Style="{StaticResource MacTodayButtonStyle}"
                                Margin="0,0,6,0"
                                Click="BtnToday_Click"/>
                        <Button x:Name="BtnPrevMonth"
                                Style="{StaticResource MacNavButtonStyle}"
                                ToolTip="上一月 (滚轮向上)"
                                Click="BtnPrevMonth_Click">
                            <Path Data="M6.5,2 L2.5,6 L6.5,10"
                                  Width="9" Height="12"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Button>
                        <Button x:Name="BtnNextMonth"
                                Style="{StaticResource MacNavButtonStyle}"
                                Margin="2,0,0,0"
                                ToolTip="下一月 (滚轮向下)"
                                Click="BtnNextMonth_Click">
                            <Path Data="M2.5,2 L6.5,6 L2.5,10"
                                  Width="9" Height="12"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. 星期标头（周一起始，周末柔和区分） -->
                <UniformGrid Columns="7" Margin="0,0,0,6">
                    <TextBlock Text="一" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CalSecondaryFgBrush}"/>
                    <TextBlock Text="二" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CalSecondaryFgBrush}"/>
                    <TextBlock Text="三" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CalSecondaryFgBrush}"/>
                    <TextBlock Text="四" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CalSecondaryFgBrush}"/>
                    <TextBlock Text="五" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CalSecondaryFgBrush}"/>
                    <TextBlock Text="六" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CalWeekendFgBrush}"/>
                    <TextBlock Text="日" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CalWeekendFgBrush}"/>
                </UniformGrid>

                <!-- 晶体细分割线 -->
                <Border Height="1" Background="{DynamicResource CalSeparatorBrush}" Margin="2,0,2,6"/>

                <!-- 3. 7×6 月历网格（公历等宽数字 + 农历/节气/节日） -->
                <UniformGrid x:Name="DaysGrid"
                             Rows="6"
                             Columns="7"
                             Margin="0,0,0,10"/>

                <!-- 4. 底部选中日详情液态玻璃微卡片 -->
                <Border x:Name="FooterCard"
                        CornerRadius="13"
                        Background="{DynamicResource CalFooterBgBrush}"
                        BorderBrush="{DynamicResource CalFooterBorderBrush}"
                        BorderThickness="1"
                        Padding="13,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSelectedSolar"
                                       Text="2026年11月27日 · 星期五"
                                       FontFamily="Segoe UI Variable Display, -apple-system, PingFang SC, Microsoft YaHei UI"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource CalFgBrush}"/>
                            <TextBlock x:Name="TxtSelectedLunar"
                                       Text="农历丙午(马)年 十月十九"
                                       FontFamily="Segoe UI Variable Text, -apple-system, PingFang SC, Microsoft YaHei UI"
                                       FontSize="11"
                                       Margin="0,2.5,0,0"
                                       Foreground="{DynamicResource CalSecondaryFgBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <Border x:Name="BadgeRelative"
                                    CornerRadius="7"
                                    Background="{DynamicResource CalBadgeBgBrush}"
                                    Padding="7.5,2.5"
                                    HorizontalAlignment="Right">
                                <TextBlock x:Name="TxtRelativeDay"
                                           Text="今天"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource CalSecondaryFgBrush}"/>
                            </Border>
                            <Border x:Name="BadgeSpecial"
                                    CornerRadius="7"
                                    Background="{DynamicResource CalTodayPillBgBrush}"
                                    Padding="7.5,2.5"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Right"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="TxtSpecialBadge"
                                           Text="小雪"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource CalAccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
