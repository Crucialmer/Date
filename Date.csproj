<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.0.6</Version>
    <AssemblyTitle>Date</AssemblyTitle>
    <Description>基于 macOS 26 设计美学的 Windows 11 任务栏日期与星期显示小工具</Description>
    <Company>Crucialmer</Company>
    <Product>Date</Product>
    <Copyright>Copyright © 2026 Crucialmer</Copyright>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\tray.ico" />
    <Resource Include="Assets\app.png" />
    <Resource Include="Assets\tray.png" />
    <EmbeddedResource Include="Assets\tray.ico" />
    <EmbeddedResource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
