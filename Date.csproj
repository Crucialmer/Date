<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.0.22</Version>
    <AssemblyVersion>1.0.22.0</AssemblyVersion>
    <FileVersion>1.0.22.0</FileVersion>
    <AssemblyTitle>Date</AssemblyTitle>
    <Description>基于 macOS 26 Liquid Glass 设计美学的 Windows 11 任务栏日期与星期显示小工具</Description>
    <Company>Crucialmer</Company>
    <Product>Date</Product>
    <Copyright>Copyright © 2026 Crucialmer</Copyright>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF 入口需在 app.manifest 中声明 PerMonitorV2（WinForms 仅用于托盘 NotifyIcon，抑制 WFO0003 误报） -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 单文件绿色便携：仅内嵌必要资源（WPF Logo 与托盘图标），消除重复打包体积 -->
    <Resource Include="Assets\app.png" />
    <EmbeddedResource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
