<Window x:Class="Date.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Date"
        Height="30"
        SizeToContent="Width"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- 平滑过渡动画样式 -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>

    <!-- macOS 26 极简玻璃胶囊容器 -->
    <Border x:Name="PillContainer"
            CornerRadius="15"
            Margin="2,1"
            Padding="11,0"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        
        <Border.Effect>
            <DropShadowEffect x:Name="PillShadow" 
                              BlurRadius="8" 
                              Direction="270" 
                              ShadowDepth="1" 
                              Opacity="0.22" 
                              Color="#000000"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- 日期 (例如: 2026年11月22日) -->
            <TextBlock x:Name="TxtDate"
                       Text="2026年11月22日"
                       FontFamily="Segoe UI Variable Display, -apple-system, BlinkMacSystemFont, PingFang SC, Microsoft YaHei UI"
                       FontSize="11.5"
                       FontWeight="Medium"
                       VerticalAlignment="Center"/>

            <!-- 垂直晶体分隔条 -->
            <Border x:Name="Divider"
                    Width="1"
                    Height="11"
                    Margin="8,0"
                    VerticalAlignment="Center"/>

            <!-- 星期几微型药丸胶囊 (例如: 星期日) -->
            <Border x:Name="DayBadge"
                    CornerRadius="8"
                    Padding="5,1.5"
                    VerticalAlignment="Center">
                <TextBlock x:Name="TxtDayOfWeek"
                           Text="星期日"
                           FontFamily="Segoe UI Variable Text, -apple-system, BlinkMacSystemFont, PingFang SC, Microsoft YaHei UI"
                           FontSize="10.5"
                           FontWeight="Normal"
                           VerticalAlignment="Center"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
