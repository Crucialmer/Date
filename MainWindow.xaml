<Window x:Class="Date.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Date"
        Height="34"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True">

    <!-- macOS 26 极简微曲面毛玻璃悬浮胶囊（精致小圆角） -->
    <Border x:Name="PillContainer"
            CornerRadius="8"
            Margin="2,2"
            Padding="13,4"
            BorderThickness="1"
            MinHeight="30"
            SnapsToDevicePixels="True">
        
        <Border.Effect>
            <DropShadowEffect x:Name="PillShadow" 
                              BlurRadius="10" 
                              Direction="270" 
                              ShadowDepth="1" 
                              Opacity="0.25" 
                              Color="#000000"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- 日期 (大半个字号: 13pt，高对比度清晰排版) -->
            <TextBlock x:Name="TxtDate"
                       Text="2026年11月22日"
                       FontFamily="Segoe UI Variable Display, -apple-system, BlinkMacSystemFont, PingFang SC, Microsoft YaHei UI"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <!-- 垂直晶体微发光细线 -->
            <Border x:Name="Divider"
                    Width="1"
                    Height="12"
                    Margin="9,0"
                    VerticalAlignment="Center"/>

            <!-- 星期几微型亚克力徽章（精巧圆角: 5） -->
            <Border x:Name="DayBadge"
                    CornerRadius="5"
                    Padding="6,2"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                <!-- 星期几 (大半个字号: 12pt) -->
                <TextBlock x:Name="TxtDayOfWeek"
                           Text="星期日"
                           FontFamily="Segoe UI Variable Text, -apple-system, BlinkMacSystemFont, PingFang SC, Microsoft YaHei UI"
                           FontSize="12"
                           FontWeight="Medium"
                           VerticalAlignment="Center"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
