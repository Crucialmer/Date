<Window x:Class="Date.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Date"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        Opacity="0.0"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- 动态主题笔刷 (深色为默认，由 ApplyTheme 冻结并实时同步切换) -->
        <SolidColorBrush x:Key="MenuBgBrush" Color="#EB1C1C22"/>
        <SolidColorBrush x:Key="MenuBorderBrush" Color="#48FFFFFF"/>
        <SolidColorBrush x:Key="MenuSheenBrush" Color="#16FFFFFF"/>
        <SolidColorBrush x:Key="MenuItemFgBrush" Color="#FFF5F5F7"/>
        <SolidColorBrush x:Key="MenuSecondaryFgBrush" Color="#99EBEBF5"/>
        <SolidColorBrush x:Key="MenuItemHoverBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="MenuAccentBrush" Color="#FF0A84FF"/>
        <SolidColorBrush x:Key="MenuVersionPillBgBrush" Color="#240A84FF"/>

        <!-- macOS 26 标题头部样式 (不可点击的精致元信息行) -->
        <Style x:Key="MacMenuHeaderStyle" TargetType="MenuItem">
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuItemFgBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, -apple-system, BlinkMacSystemFont, PingFang SC, Microsoft YaHei UI"/>
            <Setter Property="Padding" Value="10,6,10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS 26 Liquid Glass 菜单项样式 (全动态深浅色自适应 + 矢量图标 + 同心圆角) -->
        <Style x:Key="MacMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource MenuItemFgBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, -apple-system, BlinkMacSystemFont, PingFang SC, Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,6.5"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                                CornerRadius="9"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconHost"
                                                  Grid.Column="0"
                                                  ContentSource="Icon"
                                                  Width="14"
                                                  Height="14"
                                                  Margin="0,0,9,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"/>
                                <TextBlock x:Name="CheckMark"
                                           Grid.Column="2"
                                           Text="✓"
                                           Foreground="{DynamicResource MenuAccentBrush}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Icon" Value="{x:Null}">
                                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS 26 晶体分割线 -->
        <Style x:Key="MacSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource MenuSeparatorBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS 26 Liquid Glass 右键上下文菜单 (消除系统矩形阴影裁切，圆润通透) -->
        <ContextMenu x:Key="MacContextMenu"
                     StaysOpen="False"
                     HasDropShadow="False">
            <ContextMenu.Template>
                <ControlTemplate TargetType="ContextMenu">
                    <Border x:Name="MenuContainer"
                            CornerRadius="14"
                            Margin="14,10,14,18"
                            Background="{DynamicResource MenuBgBrush}"
                            BorderBrush="{DynamicResource MenuBorderBrush}"
                            BorderThickness="1"
                            Padding="4"
                            MinWidth="204"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22"
                                              Direction="270"
                                              ShadowDepth="5"
                                              Opacity="0.34"
                                              Color="#000000"/>
                        </Border.Effect>
                        <Grid>
                            <!-- 顶部微折射玻璃柔光层 -->
                            <Border CornerRadius="13,13,6,6"
                                    VerticalAlignment="Top"
                                    Height="26"
                                    IsHitTestVisible="False"
                                    Background="{DynamicResource MenuSheenBrush}"/>
                            <StackPanel IsItemsHost="True"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </ContextMenu.Template>
        </ContextMenu>
    </Window.Resources>

    <!-- macOS 26 Liquid Glass 悬浮药丸胶囊（对称阴影留白防裁切，各向异性高光边框 + 液态折射层 + 悬停微光） -->
    <Border x:Name="PillContainer"
            CornerRadius="14"
            Margin="6,4"
            BorderThickness="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            SnapsToDevicePixels="True">

        <Border.Effect>
            <DropShadowEffect x:Name="PillShadow"
                              BlurRadius="8"
                              Direction="0"
                              ShadowDepth="0"
                              Opacity="0.22"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <!-- 顶部液态玻璃折射微光层 (模拟 macOS 26 Liquid Glass 曲面聚光) -->
            <Border x:Name="GlassSheen"
                    CornerRadius="13,13,8,8"
                    VerticalAlignment="Top"
                    Height="14"
                    Margin="0.5,0.5,0.5,0"
                    IsHitTestVisible="False"/>

            <!-- 指针悬停微光层 (响应式液态玻璃光泽，绝不争夺焦点) -->
            <Border x:Name="HoverOverlay"
                    CornerRadius="13"
                    Opacity="0"
                    IsHitTestVisible="False"/>

            <!-- 主内容区 -->
            <StackPanel x:Name="ContentStack"
                        Orientation="Horizontal"
                        Margin="13,3.5"
                        VerticalAlignment="Center">
                <!-- 日期 (14.0pt SemiBold，等宽数字对齐，极高可读性) -->
                <TextBlock x:Name="TxtDate"
                           Text="2026年11月25日"
                           FontFamily="Segoe UI Variable Display, -apple-system, BlinkMacSystemFont, PingFang SC, Microsoft YaHei UI"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Typography.NumeralAlignment="Tabular"
                           VerticalAlignment="Center"/>

                <!-- 星期几同心圆角微型液态玻璃徽章 -->
                <Border x:Name="DayBadge"
                        CornerRadius="8.5"
                        Padding="7.5,1.5"
                        Margin="8,0,0,0"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtDayOfWeek"
                               Text="星期三"
                               FontFamily="Segoe UI Variable Text, -apple-system, BlinkMacSystemFont, PingFang SC, Microsoft YaHei UI"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- 实时时间 时:分 (14.0pt SemiBold，等宽数字防抖动) -->
                <TextBlock x:Name="TxtTime"
                           Text="20:45"
                           FontFamily="Segoe UI Variable Display, -apple-system, BlinkMacSystemFont, PingFang SC, Microsoft YaHei UI"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="8,0,0,0"
                           Typography.NumeralAlignment="Tabular"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
