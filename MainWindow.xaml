<Window x:Class="Date.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Date"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        Opacity="0.0"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- 动态主题笔刷 (深色为默认，由 ApplyTheme 冻结并实时同步切换) -->
        <SolidColorBrush x:Key="MenuBgBrush" Color="#EB1C1C22"/>
        <SolidColorBrush x:Key="MenuBorderBrush" Color="#48FFFFFF"/>
        <SolidColorBrush x:Key="MenuInnerRimBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="MenuSheenBrush" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="MenuItemFgBrush" Color="#FFF5F5F7"/>
        <SolidColorBrush x:Key="MenuSecondaryFgBrush" Color="#99EBEBF5"/>
        <SolidColorBrush x:Key="MenuItemHoverBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="MenuAccentBrush" Color="#FF0A84FF"/>
        <SolidColorBrush x:Key="MenuVersionPillBgBrush" Color="#240A84FF"/>

        <!-- macOS 26 标题头部样式 -->
        <Style x:Key="MacMenuHeaderStyle" TargetType="MenuItem">
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuItemFgBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, -apple-system, BlinkMacSystemFont, PingFang SC, Microsoft YaHei UI"/>
            <Setter Property="Padding" Value="10,6,10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS 26 Liquid Glass 菜单项样式 -->
        <Style x:Key="MacMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource MenuItemFgBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, -apple-system, BlinkMacSystemFont, PingFang SC, Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,6.5"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                                CornerRadius="9"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconHost"
                                                  Grid.Column="0"
                                                  ContentSource="Icon"
                                                  Width="14"
                                                  Height="14"
                                                  Margin="0,0,9,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"/>
                                <TextBlock x:Name="CheckMark"
                                           Grid.Column="2"
                                           Text="✓"
                                           Foreground="{DynamicResource MenuAccentBrush}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Icon" Value="{x:Null}">
                                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS 26 Liquid Glass 子菜单父项样式（带同风格液态玻璃弹出子面板） -->
        <Style x:Key="MacSubMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource MenuItemFgBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, -apple-system, BlinkMacSystemFont, PingFang SC, Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,6.5"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="ItemBorder"
                                    CornerRadius="9"
                                    Background="Transparent"
                                    Padding="{TemplateBinding Padding}"
                                    Margin="{TemplateBinding Margin}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="IconHost"
                                                      Grid.Column="0"
                                                      ContentSource="Icon"
                                                      Width="14"
                                                      Height="14"
                                                      Margin="0,0,9,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"/>
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="›"
                                               Foreground="{DynamicResource MenuSecondaryFgBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="12,0,0,1"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   Placement="Right"
                                   HorizontalOffset="-10"
                                   VerticalOffset="-14"
                                   PopupAnimation="Fade">
                                <Border CornerRadius="14"
                                        Margin="12,10,14,16"
                                        Background="{DynamicResource MenuBgBrush}"
                                        BorderBrush="{DynamicResource MenuBorderBrush}"
                                        BorderThickness="1"
                                        MinWidth="148"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20"
                                                          Direction="270"
                                                          ShadowDepth="5"
                                                          Opacity="0.34"
                                                          Color="#000000"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Border CornerRadius="13"
                                                BorderBrush="{DynamicResource MenuInnerRimBrush}"
                                                BorderThickness="1"
                                                IsHitTestVisible="False"/>
                                        <Border CornerRadius="13,13,6,6"
                                                VerticalAlignment="Top"
                                                Height="22"
                                                Margin="1,1,1,0"
                                                IsHitTestVisible="False"
                                                Background="{DynamicResource MenuSheenBrush}"/>
                                        <StackPanel IsItemsHost="True" Margin="4"/>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Icon" Value="{x:Null}">
                                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuItemHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS 26 晶体分割线 -->
        <Style x:Key="MacSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource MenuSeparatorBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS 26 Liquid Glass 双环折射右键菜单 -->
        <ContextMenu x:Key="MacContextMenu"
                     StaysOpen="False"
                     HasDropShadow="False">
            <ContextMenu.Template>
                <ControlTemplate TargetType="ContextMenu">
                    <Border x:Name="MenuContainer"
                            CornerRadius="14"
                            Margin="14,10,14,18"
                            Background="{DynamicResource MenuBgBrush}"
                            BorderBrush="{DynamicResource MenuBorderBrush}"
                            BorderThickness="1"
                            MinWidth="206"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22"
                                              Direction="270"
                                              ShadowDepth="5"
                                              Opacity="0.34"
                                              Color="#000000"/>
                        </Border.Effect>
                        <Grid>
                            <!-- 内部 1px 晶体高光环（浅色模式清晰立体，深色模式温润折射） -->
                            <Border CornerRadius="13"
                                    BorderBrush="{DynamicResource MenuInnerRimBrush}"
                                    BorderThickness="1"
                                    IsHitTestVisible="False"/>
                            <!-- 顶部微折射柔光层 -->
                            <Border CornerRadius="13,13,6,6"
                                    VerticalAlignment="Top"
                                    Height="24"
                                    Margin="1,1,1,0"
                                    IsHitTestVisible="False"
                                    Background="{DynamicResource MenuSheenBrush}"/>
                            <StackPanel IsItemsHost="True" Margin="4"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </ContextMenu.Template>
        </ContextMenu>
    </Window.Resources>

    <!-- macOS 26 Liquid Glass 双环光学折射悬浮胶囊（全曲面同心圆角 + 外廓连续描边 + 内部晶体高光环 + 光学垂直居中） -->
    <Border x:Name="PillContainer"
            CornerRadius="16"
            Margin="7,4"
            BorderThickness="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            SnapsToDevicePixels="True">

        <Border.Effect>
            <DropShadowEffect x:Name="PillShadow"
                              BlurRadius="8"
                              Direction="0"
                              ShadowDepth="0"
                              Opacity="0.22"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <!-- 内部 1px 液态晶体高光环：解决浅色模式左上轮廓融底问题，深色模式增强玻璃厚度折射 -->
            <Border x:Name="InnerRim"
                    CornerRadius="15"
                    BorderThickness="1"
                    IsHitTestVisible="False"/>

            <!-- 顶部柔光微折射层（轻盈克制，不压低文本光学重心） -->
            <Border x:Name="GlassSheen"
                    CornerRadius="14.5,14.5,8,8"
                    VerticalAlignment="Top"
                    Height="13"
                    Margin="1,1,1,0"
                    IsHitTestVisible="False"/>

            <!-- 指针悬停微光响应层 -->
            <Border x:Name="HoverOverlay"
                    CornerRadius="15"
                    Opacity="0"
                    IsHitTestVisible="False"/>

            <!-- 主内容区（含 CJK 光学基线微校） -->
            <StackPanel x:Name="ContentStack"
                        Orientation="Horizontal"
                        Margin="14,3.5"
                        VerticalAlignment="Center">
                <!-- 日期 (完整 yyyy年M月d日，14.0pt SemiBold，等宽数字) -->
                <TextBlock x:Name="TxtDate"
                           Text="2026年11月26日"
                           FontFamily="Segoe UI Variable Display, -apple-system, BlinkMacSystemFont, PingFang SC, Microsoft YaHei UI"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Padding="0,0,0,0.6"
                           Typography.NumeralAlignment="Tabular"
                           VerticalAlignment="Center"/>

                <!-- 星期几同心圆角液态玻璃微胶囊 -->
                <Border x:Name="DayBadge"
                        CornerRadius="9"
                        Padding="8,1.5"
                        Margin="9,0,0,0"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtDayOfWeek"
                               Text="星期四"
                               FontFamily="Segoe UI Variable Text, -apple-system, BlinkMacSystemFont, PingFang SC, Microsoft YaHei UI"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Padding="0,0,0,0.6"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- 实时时间 时:分 (14.0pt SemiBold，等宽数字) -->
                <TextBlock x:Name="TxtTime"
                           Text="17:08"
                           FontFamily="Segoe UI Variable Display, -apple-system, BlinkMacSystemFont, PingFang SC, Microsoft YaHei UI"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Padding="0,0,0,0.6"
                           Margin="9,0,0,0"
                           Typography.NumeralAlignment="Tabular"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
